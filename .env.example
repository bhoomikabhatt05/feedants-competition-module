# Server
PORT=4000
# Real MongoDB (required in production). Empty = local dev in-memory fallback only.
MONGODB_URI=
# Comma-separated allowed origins; empty = permissive (local dev / Expo).
CORS_ORIGIN=
# Reserved for production JWT auth (demo device-id auth needs no secret).
JWT_SECRET=
# Razorpay — BACKEND ONLY. Empty = DEMO/MOCK payments (no real money).
# NEVER put these in React Native / EXPO_PUBLIC_* variables.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Mobile (Expo — safe to expose)
EXPO_PUBLIC_API_URL=http://localhost:4000
